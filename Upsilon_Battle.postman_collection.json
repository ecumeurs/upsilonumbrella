							"raw": "{\n    \"request_id\": \"UUID_V7_PLACEHOLDER\",\n    \"message\": \"Perform Move Action\",\n    \"success\": true,\n    \"data\": {\n        \"entity_id\": \"entity-uuid-here\",\n        \"type\": \"move\",\n        \"target_coords\": [{ \"x\": 5, \"y\": 3 }]\n    },\n    \"meta\": {}\n}",
