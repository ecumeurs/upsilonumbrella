					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.request.body.raw = pm.request.body.raw.replace('UUID_V7_PLACEHOLDER', pm.variables.replace('{{$guid}}'));"
								],
								"type": "text/javascript"
							}
